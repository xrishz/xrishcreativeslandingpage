# Primary public origin. Netlify uses this for canonical and social metadata.
NEXT_PUBLIC_SITE_URL=https://xrishcreatives.com

# Public Stream identifiers from the Cloudflare Stream embed code.
# Enter only the code after customer- and before .cloudflarestream.com.
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=18nmsvzvjt4m41a5

# Server-only Meta Graph API values for Latest from XRISH.
# Never expose the Page access token through a NEXT_PUBLIC_ variable.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v26.0
