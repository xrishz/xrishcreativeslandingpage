# Set to the final public origin after choosing a hosting provider.
# Example only: https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Public Stream identifiers from the Cloudflare Stream embed code.
# Leave blank to show the Full Pre-debut Film / Coming soon placeholder.
# Enter only the code after customer- and before .cloudflarestream.com.
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=
NEXT_PUBLIC_PREDEBUT_STREAM_VIDEO_ID=
